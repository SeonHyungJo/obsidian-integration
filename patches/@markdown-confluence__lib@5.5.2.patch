+// fork patch: cap concurrent Confluence fetches so large vaults don't OOM the renderer.
+const FETCH_CONCURRENCY = 5;
+let __active = 0;
+const __waiters = [];
+async function withFetchLimit(fn) {
+    if (__active >= FETCH_CONCURRENCY) {
+        await new Promise((resolve) => __waiters.push(resolve));
+    }
+    __active++;
+    try {
+        return await fn();
+    }
+    finally {
+        __active--;
+        const next = __waiters.shift();
+        if (next) {
